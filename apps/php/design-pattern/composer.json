{
    "name": "design-pattern/php",
    "autoload": {
        "psr-4": { "DesignPattern\\": "src/" },
        "classmap": ["src/"]
    },
    "autoload-dev": {
        "psr-4": { "DesignPattern\\Tests\\": "tests/" }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "scripts": {
        "test": "./vendor/bin/phpunit",
        "phpcs": "./vendor/bin/phpcs",
        "phpcbf": "./vendor/bin/phpcbf",
        "check": ["@phpcs", "@test"]
    }
}
