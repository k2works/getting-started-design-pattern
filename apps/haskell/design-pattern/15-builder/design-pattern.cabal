cabal-version: 3.0
name:          design-pattern-builder
version:       0.1.0.0
build-type:    Simple

library
  exposed-modules:     Builder
  hs-source-dirs:      src
  build-depends:       base >=4.14 && <5
  default-language:    Haskell2010
  ghc-options:         -Wall

test-suite tests
  type:                exitcode-stdio-1.0
  main-is:             Main.hs
  hs-source-dirs:      test
  other-modules:       BuilderTest
  build-depends:
      base >=4.14 && <5,
      HUnit,
      design-pattern-builder
  default-language:    Haskell2010
  ghc-options:         -Wall
