cabal-version: 3.0
name:          design-pattern
version:       1.0.0
build-type:    Simple
synopsis:      GoF Design Patterns in Haskell with TDD

library
  exposed-modules:
    TemplateMethod
    Strategy
    Observer
    Composite
    IteratorPattern
    Command
    Adapter
    Proxy
    Decorator
    Singleton
    Factory
    Builder
    Interpreter
  build-depends:
    base       >=4.14 && <5,
    containers,
    directory,
    filepath
  hs-source-dirs:   src
  default-language:  Haskell2010
  ghc-options:       -Wall

test-suite tests
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  other-modules:
    TemplateMethodTest
    StrategyTest
    ObserverTest
    CompositeTest
    IteratorPatternTest
    CommandTest
    AdapterTest
    ProxyTest
    DecoratorTest
    SingletonTest
    FactoryTest
    BuilderTest
    InterpreterTest
  build-depends:
    base,
    design-pattern,
    HUnit,
    directory,
    filepath,
    temporary
  hs-source-dirs:   test
  default-language:  Haskell2010
  ghc-options:       -Wall
